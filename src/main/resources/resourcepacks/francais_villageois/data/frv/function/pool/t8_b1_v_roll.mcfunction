execute if score #r frv.tmp matches 2 run scoreboard players set @s frv.q 128
execute if score #r frv.tmp matches 3 run scoreboard players set @s frv.q 129
execute if score #r frv.tmp matches 4 run scoreboard players set @s frv.q 130
execute if score #r frv.tmp matches 5 run scoreboard players set @s frv.q 131
execute if score #r frv.tmp matches 6 run scoreboard players set @s frv.q 132
execute if score #r frv.tmp matches 7 run scoreboard players set @s frv.q 133
